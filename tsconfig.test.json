{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "inlineSources": true,
    "paths": {
      "@scalable.software/graph": ["./src/index.js"]
    },
    "types": ["jasmine", "node"],
    "declaration": false
  },
  "include": [
    "./src/**/*",
    "./test/unit/**/*",
    "./test/helper/helper.d.ts",
    "./test/helper/helper.js"
  ],
  "exclude": ["node_modules", "dist", "tasks"],
  "typedocOptions": {
    "entryPoints": ["./src/*.ts", "./src/**/*.ts"],
    "excludePrivate": true,
    "excludeProtected": true,
    "disableSources": true,
    "sort": ["kind", "static-first"],
    "name": "Graph",
    "plugin": ["typedoc-plugin-merge-modules"],
    "mergeModulesMergeMode": "module",
    "hideGenerator": true,
    "customFooterHtml": "Copyright <strong>Scalable.Software</strong> 2025",
    "categorizeByGroup": false,
    "categoryOrder": [
      "Factory",
      "State",
      "Data",
      "Operations",
      "Validation",
      "*"
    ]
  }
}
